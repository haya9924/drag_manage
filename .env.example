# 待ち受けアドレス。既定は 127.0.0.1（このPCからのみ）。
# LAN などへ公開する場合だけ 0.0.0.0 などを明示してください。
HOST=127.0.0.1

# 待ち受けポート
PORT=8898

# Hermes 操作用 API (/api/agent/*) の Bearer トークン。
# 未設定の場合 /api/agent/* は fail closed（すべて拒否）になります。必ず設定してください。
HERMES_TOKEN=change-me

# HERMES_TOKEN の互換フォールバック（HERMES_TOKEN が未設定のときのみ使用）
# INGEST_TOKEN=change-me

# ローカル時刻のタイムゾーンオフセット（分）。日本時間は 540。
APP_TZ_OFFSET_MINUTES=540

# 服用予定時刻から何分後に「飲み忘れ」とみなすか
MISS_AFTER_MINUTES=120

# 通知APIが返す「服用時刻が来た」予定の猶予（分）
REMINDER_WINDOW_MINUTES=60
